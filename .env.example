# ============================================
# Fraud Detection Platform — Environment Variables
# ============================================
# Copy this file to .env and update the values

# ---------- PostgreSQL ----------
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass_2024
POSTGRES_DB=fraud_detection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---------- RabbitMQ ----------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# ---------- API Gateway ----------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ---------- MCP Server ----------
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live

# ---------- Anomaly Detection Thresholds ----------
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_TRANSACTIONS=5
AMOUNT_MULTIPLIER=3.0
AMOUNT_WINDOW_HOURS=24
