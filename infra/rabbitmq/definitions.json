{
  "vhosts": [
    { "name": "/" }
  ],
  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "fdp.transactions",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "fdp.alerts",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "fdp.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "fdp.transaction.process",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "fdp.dlx",
        "x-dead-letter-routing-key": "dlq.transaction"
      }
    },
    {
      "name": "fdp.fraud.alerts",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "fdp.dlq.transaction",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "fdp.transactions",
      "vhost": "/",
      "destination": "fdp.transaction.process",
      "destination_type": "queue",
      "routing_key": "transaction.created",
      "arguments": {}
    },
    {
      "source": "fdp.alerts",
      "vhost": "/",
      "destination": "fdp.fraud.alerts",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "fdp.dlx",
      "vhost": "/",
      "destination": "fdp.dlq.transaction",
      "destination_type": "queue",
      "routing_key": "dlq.transaction",
      "arguments": {}
    }
  ]
}
